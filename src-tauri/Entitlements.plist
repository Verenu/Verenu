<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Tauri signs the macOS bundle with hardened runtime enabled. Under hardened
       runtime, microphone capture requires this entitlement or the process is
       denied access to the input device. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- The app is self-signed (no Apple Team), so allow loading the system
       frameworks / WebKit without strict library validation against our cert. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
