{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Verenu Development",
  "identifier": "com.verenu.app.dev",
  "app": {
    "security": {
      "capabilities": [
        "default",
        "pill",
        {
          "identifier": "development-vite-main",
          "description": "Allows the local Vite development origin to use plugin commands that still require an explicit remote capability.",
          "windows": ["main"],
          "local": false,
          "remote": {
            "urls": ["http://127.0.0.1:1420/*"]
          },
          "permissions": ["verenu-security:default"]
        }
      ]
    }
  },
  "bundle": {
    "macOS": {
      "bundleName": "Verenu Development"
    }
  }
}
