{
  "name": "open-flow",
  "version": "0.11.0",
  "description": "Open Flow - An open-source AI dictation app for Windows",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tauri-host": "node scripts/vite-dev-server.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "npm run check && cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:smoke": "node tests/smoke/test.cjs && node tests/smoke/test-app.cjs && node tests/smoke/playwright-test-ui.cjs && node tests/smoke/playwright-test-fixes.cjs",
    "test:smoke:state": "node tests/smoke/playwright-test-state.cjs",
    "tauri": "node scripts/tauri-cli.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/cli": "^2.11.1",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.28.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.14",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.8",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "@tauri-apps/plugin-shell": "^2.3.5"
  }
}
